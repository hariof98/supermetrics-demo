---
import { Image } from "astro:assets";
import type { ImageOutputFormat, ImageMetadata } from "astro";

const DEFAULT_IMAGE_FORMAT: ImageOutputFormat = "webp";

interface Props {
    src: ImageMetadata;
    alt: string;
    width?: number;
    height?: number;
    loading?: "lazy" | "eager";
    class?: string;
}

const { src, alt, width = 50, height = 50, loading = "lazy", class: className } = Astro.props as Props;
---

<Image src={src} alt={alt} width={width} height={height} loading={loading} format={DEFAULT_IMAGE_FORMAT} class={className} />
