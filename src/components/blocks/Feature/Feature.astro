---
import Container from "../../atoms/Container/Container.astro";
import Text from "../../atoms/Text/Text.astro";
import Link from "../../atoms/Link/Link.astro";
import type { Props as LinkProps } from "../../atoms/Link/Link.astro";
import Image from "../../atoms/Image/Image.astro";
import type { Props as ImageProps } from "../../atoms/Image/Image.astro";

type Position = "left" | "right";

type Links = Pick<LinkProps, "href" | "external" | "label"> & {
    text: string;
};

type FeatureImage = Pick<ImageProps, "src" | "alt">;

interface Props {
    imagePosition: Position;
    heading: string;
    description: string;
    links?: Links[];
    image?: FeatureImage;
}

const { imagePosition = "left", heading, description, links = [], image } = Astro.props as Props;
---

<section class="feature">
    <Container>
        <div class:list={["feature-inner", `feature-${imagePosition}`]}>
            <div class="feature-content">
                <Text as="h2" variant="heading" class="feature-heading">{heading}</Text>

                <Text variant="body" class="feature-description">
                    {description}
                </Text>

                {
                    links.length > 0 && (
                        <div class="feature-links" aria-label="Feature links">
                            {links.map(({ text, ...linkProps }) => (
                                <Link {...linkProps} class="feature-link">
                                    {text}
                                </Link>
                            ))}
                        </div>
                    )
                }
            </div>

            {
                image && (
                    <div class="feature-media">
                        <Image {...image} loading="lazy" />
                    </div>
                )
            }
        </div>
    </Container>
</section>

<style>
    .feature {
        padding-block: var(--spacing-section);
    }

    .feature-inner {
        display: grid;
        gap: clamp(2rem, 5vw, 5rem);
        align-items: center;
    }

    .feature-content {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        max-width: 36rem;
    }

    .feature-heading {
        max-width: 18ch;
    }

    .feature-description {
        color: var(--color-body);
    }

    .feature-links {
        display: flex;
        flex-direction: column;
        gap: 0.875rem;
        margin-top: 0.5rem;
    }

    .feature-link {
        display: inline-flex;
        width: fit-content;
        font-weight: 500;
    }

    .feature-media {
        position: relative;
        overflow: hidden;
        border-radius: 1.5rem;
        border: 1px solid color-mix(in srgb, var(--color-caption) 24%, var(--color-surface));
        background: linear-gradient(180deg, color-mix(in srgb, var(--color-subheading) 6%, white), var(--color-surface));
        box-shadow:
            0 1.5rem 3rem color-mix(in srgb, var(--color-heading) 8%, transparent),
            0 0 0 1px color-mix(in srgb, var(--color-surface) 60%, transparent) inset;
    }

    .feature-media :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 4 / 3;
        object-fit: cover;
    }

    @media (min-width: 48rem) {
        .feature-inner {
            grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
        }

        .feature-left .feature-content {
            order: 2;
        }

        .feature-left .feature-media {
            order: 1;
        }
    }
</style>
