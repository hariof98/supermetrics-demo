---
import Container from "../../atoms/Container/Container.astro";
import Text from "../../atoms/Text/Text.astro";
import Button from "../../atoms/Button/Button.astro";
import type { Props as ButtonProps } from "../../atoms/Button/Button.astro";

type Cta = Pick<ButtonProps, "href" | "variant" | "tone" | "external" | "label"> & {
    text: string;
};

interface Props {
    heading: string;
    description: string;
    ctas?: Cta[];
}

const { heading, description, ctas = [] } = Astro.props as Props;
---

<section class="action">
    <Container>
        <div class="action-content">
            <Text as="h2" variant="heading" class="action-heading">{heading}</Text>

            <Text variant="body" class="action-description">
                {description}
            </Text>

            {
                ctas.length > 0 && (
                    <div class="action-ctas">
                        {ctas.map(({ text, ...buttonProps }) => (
                            <Button {...buttonProps}>{text}</Button>
                        ))}
                    </div>
                )
            }
        </div>
    </Container>
</section>

<style>
    .action {
        padding-block: var(--spacing-section);
    }

    .action-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
        padding: clamp(2rem, 4vw, 4rem);
        border: 1px solid color-mix(in srgb, var(--color-caption) 24%, var(--color-surface));
        border-radius: 1.5rem;
        background: linear-gradient(180deg, color-mix(in srgb, var(--color-subheading) 6%, white), var(--color-surface));
        box-shadow:
            0 1.5rem 3rem color-mix(in srgb, var(--color-heading) 8%, transparent),
            0 0 0 1px color-mix(in srgb, var(--color-surface) 60%, transparent) inset;
        text-align: center;
    }

    .action-heading {
        max-width: 16ch;
    }

    .action-description {
        max-width: 42rem;
        color: var(--color-body);
    }

    .action-ctas {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.875rem;
        width: 100%;
        margin-top: 0.5rem;
    }

    @media (min-width: 48rem) {
        .action-content {
            gap: 1.75rem;
        }

        .action-ctas {
            flex-direction: row;
            justify-content: center;
            flex-wrap: wrap;
            gap: 1rem;
        }
    }
</style>
