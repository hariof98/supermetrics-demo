---
import Container from "../components/atoms/Container/Container.astro";
import Text from "../components/atoms/Text/Text.astro";
---

<Container as="footer" class="site-footer site-footer-inner">
    <Text as="p" variant="body" class="font-sora font-semibold text-heading mb-15 border-t border-solid p-[2.5]">Demo Marketing Website</Text>
</Container>

<style>
    .site-footer-inner {
        padding-block: 2rem;
        padding: 20px;
    }

    .site-footer-title {
        font-family: var(--font-sora);
        font-weight: 600;
        color: var(--color-heading);
        margin-bottom: 60px;
        border-top: 1px solid;
        padding: 10px;
    }
</style>
