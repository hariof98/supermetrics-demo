---
import BaseLayout from "../layouts/BaseLayout.astro";
import Text from "../components/atoms/Text/Text.astro";
---

<BaseLayout title="Home">
    <main class="mx-auto max-w-content p-gutter">
        <Text as="h1" variant="heading">Astro</Text>
        <Text variant="subheading" class="mt-4">Tailwind 4 theme tokens are active. Headings should render in Sora.</Text>
        <Text variant="body" class="mt-4">Tailwind 4 theme tokens are active. Headings should render in Sora.</Text>
        <Text variant="caption" class="mt-4">Tailwind 4 theme tokens are active. Headings should render in Sora.</Text>
    </main>
</BaseLayout>
