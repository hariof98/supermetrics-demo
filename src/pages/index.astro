---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blockRegistry } from "../components/blocks/registry";

const pages = await getCollection("pages");
const page = pages.find((p) => p.id === "homepage");

if (!page) throw new Error("homepage entry not found in pages collection");

const { title, description, blocks } = page.data;
---

<BaseLayout title={title} description={description}>
    {
        blocks.map((block) => {
            /* the discriminated union guarantees props match the component,
            but TypeScript can't prove it through a registry lookup. */
            const Block = blockRegistry[block.type] as (props: typeof block) => unknown;

            return Block ? <Block {...block} /> : null;
        })
    }
</BaseLayout>
