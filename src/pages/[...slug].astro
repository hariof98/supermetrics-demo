---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { blockRegistry } from "../components/blocks/registry";

// already the default, but declared manually so the SSG choice is visible in the file
export const prerender = true;

export async function getStaticPaths() {
    const pages = await getCollection("pages");

    return pages.map((page) => ({
        params: { slug: page.id === "homepage" ? undefined : page.id },
        props: { page },
    }));
}

const { page } = Astro.props;
const { title, description, blocks } = page.data;
---

<BaseLayout title={title} description={description}>
    {
        blocks.map((block) => {
            const Block = blockRegistry[block.type] as (props: typeof block) => unknown;
            return Block ? <Block {...block} /> : null;
        })
    }
</BaseLayout>
